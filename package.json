{
  "name": "hosn-obe",
  "version": "0.0.0",
  "private": true,
  "description": "Hosn Obe — multiplayer card game (monorepo)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w @hosn-obe/server",
    "dev:client": "npm run dev -w @hosn-obe/client"
  },
  "engines": {
    "node": ">=20"
  }
}
